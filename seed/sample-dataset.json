        "citationCount": 0,
        "referenceCount": 0,
        "searchText": "supply chain integrity at scale: a systematic review supply chain integrity cybersecurity homomorphic encryption link prediction"
      },
      {
        "id": "paper-0002",
        "title": "Towards Robust Tactile Sensing",
        "abstract": "Results reported for Tactile Sensing are difficult to compare because baselines differ between papers. We derive bounds relating spectroscopy to observed error and use them to design a practical spectral clustering procedure. Across 3 independent settings the method improves on strong baselines while using 21 percent less compute. These findings suggest that reporting standards for Tactile Sensing need to change.",
        "year": 2023,
        "doi": "10.3869/rn.00002",
