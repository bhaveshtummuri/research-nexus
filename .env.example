# ---------------------------------------------------------------------------
# Research Nexus - environment template
#
# Copy this file to `.env` at the repository root. The server, the seed
# package and the client dev proxy all read from this single file.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- CognoDB (Neo4j Bolt protocol) -----------------------------------------
# This file is a template and is committed. Never put a real password in it.
#
# Local docker/binary instance:  bolt://localhost:7687
# Managed / TLS instance:        bolt+s://<host>  (the +s carries the TLS policy;
#                                a plain bolt:// against a managed host fails
#                                the handshake with a confusing socket error)
COGNODB_URI=
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=
# Leave empty to use the server default database.
COGNODB_DATABASE=

# Connection pool + resilience tuning (milliseconds unless stated otherwise).
COGNODB_MAX_POOL_SIZE=50
COGNODB_CONNECTION_TIMEOUT_MS=15000
COGNODB_MAX_TRANSACTION_RETRY_MS=15000
# Set to true when the deployment terminates TLS with a self-signed cert.
COGNODB_ENCRYPTED=false

# --- HTTP server ------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1
LOG_LEVEL=info

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fixed-window rate limiting for the public API.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300

# Upper bound applied to every `limit` query parameter and graph expansion.
MAX_PAGE_SIZE=100
MAX_GRAPH_NODES=400

# --- Seeding ----------------------------------------------------------------
# Deterministic pseudo-random seed: the same value always produces the same graph.
SEED_RANDOM_SEED=research-nexus-2024
# Rows sent to CognoDB per UNWIND batch.
SEED_BATCH_SIZE=500

# --- Client -----------------------------------------------------------------
# Base URL the browser uses to reach the API. In development the Vite proxy
# handles this, so the value can stay empty for same-origin requests.
VITE_API_BASE_URL=http://localhost:4000/api/v1
