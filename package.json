{
  "name": "research-nexus",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered research collaboration and knowledge discovery platform built on a property graph.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "server",
    "client",
    "seed"
  ],
  "scripts": {
    "build": "npm run build --workspace server && npm run build --workspace client",
    "build:client": "npm run build --workspace client",
    "build:server": "npm run build --workspace server",
    "db:reset": "npm run reset --workspace seed",
    "db:sample": "npm run sample --workspace seed",
    "db:schema": "npm run schema --workspace seed",
    "db:seed": "npm run seed --workspace seed",
    "db:stats": "npm run stats --workspace seed",
    "db:validate": "npm run validate --workspace seed",
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspaces --if-present",
    "test:client": "npm run test --workspace client",
    "test:db": "RUN_DB_TESTS=1 vitest run --root server tests/integration/graph-queries.test.ts",
    "test:integration": "vitest run --root server tests/integration",
    "test:perf": "RUN_DB_TESTS=1 vitest run --root server tests/performance",
    "test:seed": "npm run test --workspace seed",
    "test:server": "npm run test --workspace server",
    "test:unit": "vitest run --root server tests/unit",
    "test:watch": "vitest --root server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run typecheck && npm run lint && npm run build && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.15.0",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
